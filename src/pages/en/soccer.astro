---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

import CalendarTable from "@components/CalendarTable.astro";
import { toTableItems } from "@libs/soccerTransformer";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "en") as "vi" | "en";
const t = useTranslations(currentLocale);

const model = "soccer";
const collection = await getCollection(model);
const items = toTableItems(collection, model);
---

<Layout>
    <div>
        <CalendarTable
            header={[
                { key: "league", label: t("soccer.league") },
                { key: "match", label: t("soccer.match") },
                { key: "start", label: t("soccer.start") },
                { key: "bet_100", label: t("soccer.bet100") },
                { key: "win_win", label: t("soccer.winwin") },
                { key: "win_draw", label: t("soccer.windraw") },
            ]}
            items={items}
        />
    </div>
</Layout>
