---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

import CalendarTable from "@components/CalendarTable.astro";
import { toChart, toTableItems, attachComparison } from "@libs/commonTransformer";
import Chart from "@components/Chart.astro";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "en") as "vi" | "en";
const t = useTranslations(currentLocale);

const model = "oil";
const collection = await getCollection(model);

const items = attachComparison(toTableItems(collection, model), "title", ["zone1_price", "zone2_price"]);
const chart = toChart(items, "title", "zone1_price", 30, [
    "Xăng RON 95-V",
    "Xăng RON 95-III",
    "Xăng E5 RON 92-II",
    "Xăng E10 RON 95-III",
    "DO 0,05S-II",
]);
---

<Layout image="/images/oil-station.svg">
    <div>
        <CalendarTable
            header={[
                { key: "title", label: t("oil.name") },
                { key: "zone1_price", label: t("oil.zone1") },
                { key: "zone2_price", label: t("oil.zone2") },
            ]}
            items={items}
            note={t("slider.footerNote")}
            widget="/en/oil/widget"
        >
            <Chart
                slot="chart"
                id="oil-chart"
                series={chart.series}
                categories={chart.categories}
            />
        </CalendarTable>
    </div>
</Layout>
