---
import Layout from "@layouts/BlankLayout.astro";
import { getCollection } from "astro:content";

import FuelSlider from "@components/FuelSlider.astro";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "en") as "vi" | "en";
const t = useTranslations(currentLocale);

const model = "oil";
const collection = await getCollection(model);
---

<Layout>
    <FuelSlider collection={collection} date={new Date()} />
</Layout>
