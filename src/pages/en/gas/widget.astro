---
import Layout from "@layouts/BlankLayout.astro";
import { getCollection } from "astro:content";

import GasSlider from "@components/GasSlider.astro";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "en") as "vi" | "en";
const t = useTranslations(currentLocale);

const model = "gas";
const collection = await getCollection(model);
---

<Layout>
    <GasSlider collection={collection} date={new Date()} />
</Layout>
