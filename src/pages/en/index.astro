---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import Table from "@components/Table.astro";
import { toTableItems } from "@libs/commonTransformer";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "en") as "vi" | "en";
const t = useTranslations(currentLocale);

const goldItems = toTableItems(await getCollection("gold"), "gold");
const oilItems = toTableItems(await getCollection("oil"), "oil");
---

<Layout>
	<div class="flex flex-col gap-4">
		<div class="flex flex-col sm:flex-row gap-2">
			<div class="flex-1">
				<Table
					title={t("nav.gold")}
					header={[
						{ key: "masp", label: t("gold.code") },
						{ key: "tensp", label: t("gold.name") },
						{ key: "giamua", label: t("gold.buy") },
						{ key: "giaban", label: t("gold.sell") },
					]}
					items={goldItems.at(-1)?.data || []}
				/>
			</div>
			<div class="flex-1">
				<Table
					title={t("nav.oil")}
					header={[
						{ key: "title", label: t("oil.name") },
						{ key: "zone1_price", label: t("oil.zone1") },
						{ key: "zone2_price", label: t("oil.zone2") },
					]}
					items={oilItems.at(-1)?.data || []}
				/>
			</div>
		</div>
	</div>
</Layout>
