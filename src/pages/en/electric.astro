---
import Layout from "@layouts/Layout.astro";
import { filesToItems } from "@libs/commonTransformer";
import Prose from "@components/Prose.astro";

const collection = Object.values(
    import.meta.glob("@databases/*/electric/*.md", { eager: true }),
);

const model = "electric";
const items = filesToItems(collection, model);
const latest = items.sort((a, b) => b.date - a.date).at(0);
const rawHtml = latest?.data?.compiledContent ? await latest.data.compiledContent() : "";
const contentStr = typeof rawHtml === "string" ? rawHtml : "";
const sanitizedHtml = contentStr
    .replace(/http:\/\//gi, "https://")
    .replace(/<a\s+([^>]*?)href=["']([^"']+)["']/gi, (match, p1, href) => {
        if (href.startsWith("http") || href.endsWith(".pdf")) {
            return `<a ${p1}href="${href}" rel="nofollow noopener noreferrer" target="_blank"`;
        }
        return match;
    });
---

<Layout>
    <Prose>
        <Fragment set:html={sanitizedHtml} />
    </Prose>
</Layout>
