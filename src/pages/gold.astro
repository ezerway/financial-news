---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";

import CalendarTable from "@components/CalendarTable.astro";
import { toTableItems, toChart, attachComparison } from "@libs/commonTransformer";
import Chart from "@components/Chart.astro";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "vi") as "vi" | "en";
const t = useTranslations(currentLocale);

const model = "gold";
const collection = await getCollection(model);

const items = attachComparison(toTableItems(collection, model), "masp", ["giamua", "giaban"]);
const chart = toChart(items, "masp", "giaban", 30, [
    "SJC",
    "N24K",
    "KB",
    "TL",
    "PNJ",
]);
---

<Layout image="/images/gold-bars-shiny.svg">
    <CalendarTable
        header={[
            { key: "masp", label: t("gold.code") },
            { key: "tensp", label: t("gold.name") },
            { key: "giamua", label: t("gold.buy") },
            { key: "giaban", label: t("gold.sell") },
        ]}
        items={items}
        widget="/gold/widget"
    >
        <Chart
            slot="chart"
            id="gold-chart"
            series={chart.series}
            categories={chart.categories}
        />
    </CalendarTable>
</Layout>
