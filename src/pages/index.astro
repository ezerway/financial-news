---
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import Table from "@components/Table.astro";
import { toTableItems, attachComparison } from "@libs/commonTransformer";
import { useTranslations } from "@/i18n/ui";

const currentLocale = (Astro.currentLocale || "vi") as "vi" | "en";
const t = useTranslations(currentLocale);

const goldItems = attachComparison(toTableItems(await getCollection("gold"), "gold"), "masp", ["giamua", "giaban"]);
const oilItems = attachComparison(toTableItems(await getCollection("oil"), "oil"), "title", ["zone1_price", "zone2_price"]);
const gasItems = attachComparison(toTableItems(await getCollection("gas"), "gas"), "title", ["type_1_price", "type_2_price"]);
---

<Layout>
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
		<div>
			<Table
				title={t("nav.gold")}
				header={[
					{ key: "masp", label: t("gold.code") },
					{ key: "tensp", label: t("gold.name") },
					{ key: "giamua", label: t("gold.buy") },
					{ key: "giaban", label: t("gold.sell") },
				]}
				items={goldItems.at(-1)?.data || []}
			/>
		</div>
		<div>
			<Table
				title={t("nav.oil")}
				header={[
					{ key: "title", label: t("oil.name") },
					{ key: "zone1_price", label: t("oil.zone1") },
					{ key: "zone2_price", label: t("oil.zone2") },
				]}
				items={oilItems.at(-1)?.data || []}
			/>
		</div>
		<div>
			<Table
				title={t("nav.gas")}
				header={[
					{ key: "title", label: t("gas.title") },
					{ key: "type_1_price", label: t("gas.type1") },
					{ key: "type_2_price", label: t("gas.type2") },
				]}
				items={gasItems.at(-1)?.data || []}
			/>
		</div>
	</div>
</Layout>
