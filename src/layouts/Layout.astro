---
import "../styles/global.css";
import { collections } from "@/content.config";
import {
	useTranslations,
	getLocalizedPath,
	languages,
	type UIKey,
} from "@/i18n/ui";

interface Props {
	title?: string;
	description?: string;
	image?: string;
	type?: "website" | "article";
}

const { title, description, image = "/logo.svg", type = "website" } = Astro.props;
const currentLocale = (Astro.currentLocale || "vi") as keyof typeof languages;
const t = useTranslations(currentLocale);

const currentPathname =
	Astro.url.pathname.split("/").at(-1) ||
	Astro.url.pathname.split("/").at(-2);
const isDashboard = currentPathname === "" || currentPathname === "en";

const pageTitleKey = `title.${currentPathname || "dashboard"}` as UIKey;
const pageDescKey = `desc.${currentPathname || "dashboard"}` as UIKey;

const displayTitle = title || t(pageTitleKey) || t("site.title");
const displayDescription = description || t(pageDescKey) || t("site.description");

const siteUrl = Astro.site ? Astro.site.origin : "https://financial-news.ezerway.com";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

const viURL = new URL(getLocalizedPath(Astro.url.pathname, "vi"), siteUrl).href;
const enURL = new URL(getLocalizedPath(Astro.url.pathname, "en"), siteUrl).href;

const imageUrl = image.startsWith("http") ? image : new URL(image, siteUrl).href;
const ogLocale = currentLocale === "vi" ? "vi_VN" : "en_US";

const mdPages = ["electric"];
const navPages = Object.keys(collections).concat(mdPages);

const schemaOrg = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": `${siteUrl}/#organization`,
      "name": "Financial News",
      "url": siteUrl,
      "logo": `${siteUrl}/logo.svg`
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Financial News",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": currentLocale
    },
    {
      "@type": "DataFeed",
      "@id": `${canonicalURL}#datafeed`,
      "name": displayTitle,
      "description": displayDescription,
      "provider": { "@id": `${siteUrl}/#organization` },
      "dataFeedElement": [
        {
          "@type": "DataFeedItem",
          "dateModified": new Date().toISOString().split("T")[0],
          "item": {
            "@type": "Dataset",
            "name": "Daily Financial Commodities & Utility Tariffs Vietnam",
            "description": displayDescription,
            "distribution": [
              {
                "@type": "DataDownload",
                "encodingFormat": "text/markdown",
                "contentUrl": `${siteUrl}/llms-full.txt`
              }
            ]
          }
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${canonicalURL}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": t("nav.dashboard"),
          "item": siteUrl
        },
        ...(!isDashboard ? [{
          "@type": "ListItem",
          "position": 2,
          "name": displayTitle,
          "item": canonicalURL
        }] : [])
      ]
    }
  ]
};
---

<html lang={currentLocale} class="h-full">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="referrer" content="no-referrer-when-downgrade" />
		<meta http-equiv="X-Content-Type-Options" content="nosniff" />

		<!-- Basic SEO -->
		<title>{displayTitle}</title>
		<meta name="description" content={displayDescription} />
		<link rel="canonical" href={canonicalURL} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="theme-color" content="#4f46e5" />
		<meta name="author" content="EzerWay" />

		<!-- AI & LLM Discovery Links -->
		<link rel="help" type="text/markdown" href="/llms.txt" />
		<link rel="alternate" type="text/markdown" href="/llms-full.txt" title="Full Text Data Snapshot for AI Agents" />
		<meta name="ai-content-declaration" content="official financial data snapshots" />

		<!-- Hreflang Tags -->
		<link rel="alternate" hreflang="vi" href={viURL} />
		<link rel="alternate" hreflang="en" href={enURL} />
		<link rel="alternate" hreflang="x-default" href={viURL} />

		<!-- OpenGraph / Facebook -->
		<meta property="og:type" content={type} />
		<meta property="og:site_name" content="Financial News" />
		<meta property="og:title" content={displayTitle} />
		<meta property="og:description" content={displayDescription} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={imageUrl} />
		<meta property="og:locale" content={ogLocale} />

		<!-- Twitter Cards -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={displayTitle} />
		<meta name="twitter:description" content={displayDescription} />
		<meta name="twitter:image" content={imageUrl} />

		<!-- Icons & Sitemap -->
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<meta name="generator" content={Astro.generator} />

		<!-- JSON-LD Structured Data -->
		<script type="application/ld+json" is:inline set:html={JSON.stringify(schemaOrg)} />
	</head>
	<body
		class="h-full bg-white dark:bg-gray-800 text-gray-900 dark:text-white"
	>
		<script
			src="https://cdn.jsdelivr.net/npm/@tailwindplus/elements@1"
			type="module"></script>
		<div class="min-h-full flex flex-col">
			<nav
				class="border-b border-gray-200 bg-white dark:border-white/10 dark:bg-gray-900"
			>
				<div class="mx-auto max-w-full px-4 sm:px-6 lg:px-8">
					<div class="flex h-16 justify-between">
						<div class="flex">
							<div class="flex shrink-0 items-center">
								<a href={getLocalizedPath("/", currentLocale)}>
									<img
										src="/logo.svg"
										alt="Ezer Way"
										class="h-8 w-auto dark:hidden"
									/>
									<img
										src="/logo.svg"
										alt="Ezer Way"
										class="h-8 w-auto not-dark:hidden"
									/>
								</a>
							</div>
							<div
								class="hidden sm:-my-px sm:ml-6 sm:flex sm:space-x-8"
							>
								<a
									href={getLocalizedPath("/", currentLocale)}
									class={isDashboard
										? "inline-flex items-center border-b-2 border-indigo-600 px-1 pt-1 text-sm font-medium text-gray-900 dark:border-indigo-500 dark:text-white"
										: "inline-flex items-center border-b-2 border-transparent px-1 pt-1 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:border-white/20 dark:hover:text-gray-200"}
									>{t("nav.dashboard")}</a
								>
								{
									navPages.map((collection) => {
										const navKey =
											`nav.${collection}` as UIKey;
										const isActive =
											currentPathname === collection;
										return (
											<a
												href={getLocalizedPath(
													`/${collection}`,
													currentLocale,
												)}
												aria-current={
													isActive
														? "page"
														: undefined
												}
												class={
													isActive
														? "inline-flex items-center border-b-2 border-indigo-600 px-1 pt-1 text-sm font-medium text-gray-900 dark:border-indigo-500 dark:text-white"
														: "inline-flex items-center border-b-2 border-transparent px-1 pt-1 text-sm font-medium text-gray-500 hover:border-gray-300 hover:text-gray-700 dark:text-gray-400 dark:hover:border-white/20 dark:hover:text-gray-200"
												}
											>
												{t(navKey)}
											</a>
										);
									})
								}
							</div>
						</div>
						<div
							class="hidden sm:ml-6 sm:flex sm:items-center sm:space-x-3"
						>
							<!-- Language Toggler -->
							<div
								class="inline-flex rounded-md shadow-xs"
								role="group"
							>
								<a
									href={getLocalizedPath(
										Astro.url.pathname,
										"vi",
									)}
									class={currentLocale === "vi"
										? "px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 rounded-l-md border border-indigo-600 dark:bg-indigo-500"
										: "px-2.5 py-1 text-xs font-medium text-gray-700 bg-white rounded-l-md border border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"}
								>
									VI
								</a>
								<a
									href={getLocalizedPath(
										Astro.url.pathname,
										"en",
									)}
									class={currentLocale === "en"
										? "px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 rounded-r-md border border-indigo-600 dark:bg-indigo-500"
										: "px-2.5 py-1 text-xs font-medium text-gray-700 bg-white rounded-r-md border border-gray-300 hover:bg-gray-50 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300 dark:hover:bg-gray-700"}
								>
									EN
								</a>
							</div>

							<button
								type="button"
								class="relative rounded-full p-1 text-gray-400 hover:text-gray-500 focus:outline-2 focus:outline-offset-2 focus:outline-indigo-600 dark:text-gray-400 dark:hover:text-white dark:focus:outline-indigo-500"
							>
								<span class="absolute -inset-1.5"></span>
								<span class="sr-only">View notifications</span>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									data-slot="icon"
									aria-hidden="true"
									class="size-6"
								>
									<path
										d="M14.857 17.082a23.848 23.848 0 0 0 5.454-1.31A8.967 8.967 0 0 1 18 9.75V9A6 6 0 0 0 6 9v.75a8.967 8.967 0 0 1-2.312 6.022c1.733.64 3.56 1.085 5.455 1.31m5.714 0a24.255 24.255 0 0 1-5.714 0m5.714 0a3 3 0 1 1-5.714 0"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>

							<!-- Profile dropdown -->
							<el-dropdown class="relative ml-3">
								<button
									class="relative flex max-w-xs items-center rounded-full focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 dark:focus-visible:outline-indigo-500"
								>
									<span class="absolute -inset-1.5"></span>
									<span class="sr-only">Open user menu</span>
									<img
										src="/avatar.svg"
										alt=""
										class="size-8 rounded-full outline -outline-offset-1 outline-black/5 dark:outline-white/10"
									/>
								</button>

								<el-menu
									anchor="bottom end"
									popover
									class="w-48 origin-top-right rounded-md bg-white py-1 shadow-lg outline outline-black/5 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-200 data-enter:ease-out data-leave:duration-75 data-leave:ease-in dark:bg-gray-800 dark:shadow-none dark:-outline-offset-1 dark:outline-white/10"
								>
									<a
										href="#"
										class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:outline-hidden dark:text-gray-300 dark:focus:bg-white/5"
										>{t("user.profile")}</a
									>
									<a
										href="#"
										class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:outline-hidden dark:text-gray-300 dark:focus:bg-white/5"
										>{t("user.settings")}</a
									>
									<a
										href="#"
										class="block px-4 py-2 text-sm text-gray-700 focus:bg-gray-100 focus:outline-hidden dark:text-gray-300 dark:focus:bg-white/5"
										>{t("user.signout")}</a
									>
								</el-menu>
							</el-dropdown>
						</div>
						<div class="-mr-2 flex items-center sm:hidden">
							<button
								type="button"
								command="--toggle"
								commandfor="mobile-menu"
								class="relative inline-flex items-center justify-center rounded-md bg-white p-2 text-gray-400 hover:bg-gray-100 hover:text-gray-500 focus:outline-2 focus:outline-offset-2 focus:outline-indigo-600 dark:bg-gray-900 dark:text-gray-400 dark:hover:bg-white/5 dark:hover:text-white dark:focus:outline-indigo-500"
							>
								<span class="absolute -inset-0.5"></span>
								<span class="sr-only">Open main menu</span>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									data-slot="icon"
									aria-hidden="true"
									class="size-6 in-aria-expanded:hidden"
								>
									<path
										d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="1.5"
									data-slot="icon"
									aria-hidden="true"
									class="size-6 not-in-aria-expanded:hidden"
								>
									<path
										d="M6 18 18 6M6 6l12 12"
										stroke-linecap="round"
										stroke-linejoin="round"></path>
								</svg>
							</button>
						</div>
					</div>
				</div>

				<el-disclosure id="mobile-menu" hidden class="block sm:hidden">
					<div class="space-y-1 pt-2 pb-3">
						<a
							href={getLocalizedPath("/", currentLocale)}
							class={isDashboard
								? "block border-l-4 border-indigo-600 bg-indigo-50 py-2 pr-4 pl-3 text-base font-medium text-indigo-700 dark:border-indigo-500 dark:bg-indigo-600/10 dark:text-indigo-300"
								: "block border-l-4 border-transparent py-2 pr-4 pl-3 text-base font-medium text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-800 dark:text-gray-400 dark:hover:border-gray-500 dark:hover:bg-white/5 dark:hover:text-gray-200"}
							>{t("nav.dashboard")}</a
						>
						{
							navPages.map((collection) => {
								const navKey = `nav.${collection}` as UIKey;
								const isActive = currentPathname === collection;
								return (
									<a
										href={getLocalizedPath(
											`/${collection}`,
											currentLocale,
										)}
										class={
											isActive
												? "block border-l-4 border-indigo-600 bg-indigo-50 py-2 pr-4 pl-3 text-base font-medium text-indigo-700 dark:border-indigo-500 dark:bg-indigo-600/10 dark:text-indigo-300"
												: "block border-l-4 border-transparent py-2 pr-4 pl-3 text-base font-medium text-gray-600 hover:border-gray-300 hover:bg-gray-50 hover:text-gray-800 dark:text-gray-400 dark:hover:border-gray-500 dark:hover:bg-white/5 dark:hover:text-gray-200"
										}
									>
										{t(navKey)}
									</a>
								);
							})
						}
					</div>
					<div
						class="border-t border-gray-200 pt-4 pb-3 dark:border-gray-700"
					>
						<div class="flex items-center justify-between px-4">
							<div class="flex items-center">
								<div class="shrink-0">
									<img
										src="/avatar.svg"
										alt=""
										class="size-10 rounded-full outline -outline-offset-1 outline-black/5 dark:outline-white/10"
									/>
								</div>
								<div class="ml-3">
									<div
										class="text-base font-medium text-gray-800 dark:text-white"
									>
										Rooney
									</div>
									<div
										class="text-sm font-medium text-gray-500 dark:text-gray-400"
									>
										faq@ezerway.com
									</div>
								</div>
							</div>
							<div class="inline-flex rounded-md shadow-xs">
								<a
									href={getLocalizedPath(
										Astro.url.pathname,
										"vi",
									)}
									class={currentLocale === "vi"
										? "px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 rounded-l-md border border-indigo-600 dark:bg-indigo-500"
										: "px-2.5 py-1 text-xs font-medium text-gray-700 bg-white rounded-l-md border border-gray-300 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300"}
								>
									VI
								</a>
								<a
									href={getLocalizedPath(
										Astro.url.pathname,
										"en",
									)}
									class={currentLocale === "en"
										? "px-2.5 py-1 text-xs font-semibold text-white bg-indigo-600 rounded-r-md border border-indigo-600 dark:bg-indigo-500"
										: "px-2.5 py-1 text-xs font-medium text-gray-700 bg-white rounded-r-md border border-gray-300 dark:bg-gray-800 dark:border-gray-700 dark:text-gray-300"}
								>
									EN
								</a>
							</div>
						</div>
					</div>
				</el-disclosure>
			</nav>

			<div class="py-10">
				<header>
					<div class="mx-auto max-w-full px-4 sm:px-6 lg:px-8">
						<h1
							class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white"
						>
							{displayTitle}
						</h1>
					</div>
				</header>
				<main class="grow">
					<div class="mx-auto max-w-full px-4 py-8 sm:px-6 lg:px-8">
						<slot />
					</div>
				</main>
			</div>

			<footer class="mt-auto border-t border-gray-200 bg-white py-6 dark:border-white/10 dark:bg-gray-900">
				<div class="mx-auto max-w-full px-4 text-center sm:px-6 lg:px-8">
					<p class="text-sm text-gray-500 dark:text-gray-400">
						&copy; {new Date().getFullYear()} <a href={siteUrl} class="font-medium text-indigo-600 hover:underline dark:text-indigo-400">Financial News</a>. All rights reserved.
					</p>
				</div>
			</footer>
		</div>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
