</style>

<script>
	let currentIndex = 0;
	const totalSlides = document.querySelectorAll(".slide-item").length;
	const slideInterval = 3000;
	let timer: number | null = null;

	const slides = document.querySelectorAll(".slide-item");
	const dots = document.querySelectorAll(".indicator-dot");
	const progressBar = document.getElementById("progress-bar");
	const slideCounter = document.getElementById("slide-counter");

	function updateSlider(index: number) {
		currentIndex = index;

		// Update active slide
		slides.forEach((slide, idx) => {
			if (idx === currentIndex) {
				slide.classList.add("active");
			} else {
				slide.classList.remove("active");
			}
		});

		// Update indicators
		dots.forEach((dot, idx) => {
			const fuelType = slides[idx]?.dataset.type || "table";
			const activeColor =
				fuelType === "dau"
					? "#fbbf24"
					: fuelType === "table"
						? "#94a3b8"
						: "#38bdf8";

			if (idx === currentIndex) {
				dot.classList.add("active");
				(dot as HTMLElement).style.background = activeColor;
			} else {
				dot.classList.remove("active");
				(dot as HTMLElement).style.background = "#2a3a5a";
			}
		});

		// Reset & restart progress bar animation
		if (progressBar) {
			progressBar.classList.remove("animate");
			// Trigger reflow
			void progressBar.offsetWidth;
			progressBar.classList.add("animate");

			// Set progress bar color matching current item
			const isSummary = currentIndex === totalSlides - 1;
			const isDau = slides[currentIndex]?.dataset.type === "dau";
			progressBar.style.background = isSummary
				? "#94a3b8"
				: isDau
					? "#fbbf24"
					: "#38bdf8";
		}

		if (slideCounter) {
			slideCounter.textContent = `${String(currentIndex + 1).padStart(
				2,
				"0",
			)}/${totalSlides.toString().padStart(2, "0")}`;
		}
	}

	function startTimer() {
		stopTimer();
		timer = window.setInterval(() => {
			const nextIndex = (currentIndex + 1) % totalSlides;
			updateSlider(nextIndex);
		}, slideInterval);
	}

	function stopTimer() {
		if (timer !== null) {
			clearInterval(timer);
			timer = null;
		}
	}

	// Click event for dots
	dots.forEach((dot) => {
		dot.addEventListener("click", (e) => {
			const target = e.currentTarget as HTMLElement;
			const index = parseInt(
				target.getAttribute("data-target-index") || "0",
				10,
			);
			updateSlider(index);
			startTimer(); // Restart timer on click
		});
	});

	// Initialize
	updateSlider(0);
	startTimer();
</script>

<script type="module">
	import domtoimage from "https://cdn.jsdelivr.net/npm/dom-to-image-more@3.10.2/+esm";

	const target = document.getElementById("capture-target");
	let canvas = document.querySelector("canvas");
	let ctx = canvas.getContext("2d");
	var video = document.querySelector("video");

	let images = [];
	let chunks = [];
	let mediaRecorder;
	let interval;

	const start = async () => {
		mediaRecorder = null;
		let videoStream = canvas.captureStream(30);
		mediaRecorder = new MediaRecorder(videoStream);
		interval = setInterval(() => {
			domtoimage
				.toPng(target)
				.then((dataUrl) => {
					var base_img = new Image();
					base_img.src = dataUrl;
					base_img.onload = () => {
						ctx.drawImage(base_img, 0, 0);
						images.push(base_img);
					};
				})
				.catch((error) => {
					console.error("oops, something went wrong!", error);
				});
		}, 100);

		chunks = [];
		mediaRecorder.ondataavailable = (e) => {
			chunks.push(e.data);
		};
		mediaRecorder.onstop = (e) => {
			// mp4 or webm
			let type = "video/mp4";
			if (MediaRecorder.isTypeSupported("video/mp4;codecs=avc1")) {
				type = "video/mp4;codecs=avc1";
			} else if (MediaRecorder.isTypeSupported("video/mp4")) {
				type = "video/mp4";
			} else if (MediaRecorder.isTypeSupported("video/webm")) {
				type = "video/webm";
			}
			var blob = new Blob(chunks, { type: type });
			chunks = [];
			var videoURL = URL.createObjectURL(blob);
			video.src = videoURL;
			video.classList.remove("hidden");
			// download video
			// const downloadLink = document.createElement("a");
			// downloadLink.href = videoURL;
			// downloadLink.download = `oil-${new Date().toLocaleDateString()}.mp4`;
			// downloadLink.click();
		};
		mediaRecorder.start();
	};

	const stop = async () => {
		clearInterval(interval);
		mediaRecorder.stop();
	};

	const totalSlides = document.querySelectorAll(".slide-item").length;
	const slideInterval = 3000;
	const footerText = document.getElementById("footer-text");

	footerText.addEventListener("click", () => {
		start();
		setTimeout(
			() => {
				stop();
			},
			5000 + slideInterval * totalSlides + 2000,
		);
	});
</script>
