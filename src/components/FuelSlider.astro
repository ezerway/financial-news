---
// FuelSlider.astro
import { useTranslations } from "@/i18n/ui";

export interface FuelItem {
	id: string;
	shortName: string;
	sub: string | null;
	type: "xang" | "dau";
	v1: string;
	v2: string;
	v1n: number;
	v2n: number;
}

export interface Props {
	collection: any[];
	date: Date;
}

const { collection, date } = Astro.props;

const currentLocale = (Astro.currentLocale || "vi") as "vi" | "en";
const t = useTranslations(currentLocale);
const numLocale = currentLocale === "en" ? "en-US" : "vi-VN";

const fuelData: FuelItem[] = collection?.at(0).data.map((item: any) => {
	return {
		id: item.title,
		shortName: item.title,
		sub: item.title,
		type: item.title.includes("Xăng") ? "xang" : "dau",
		v1: item.zone1_price?.toLocaleString(numLocale),
		v2: item.zone2_price?.toLocaleString(numLocale),
		v1n: item.zone1_price,
		v2n: item.zone2_price,
	};
});

const totalSlides = fuelData.length + 1;

const displayDate = `${date.getDate().toString().padStart(2, "0")}. ${(
	date.getMonth() + 1
)
	.toString()
	.padStart(2, "0")}. ${date.getFullYear()}`;
---

<div class="slider-wrapper">
	<div id="capture-target" class="slider-card">
		<!-- Header -->
		<div class="card-header">
			<div class="header-content">
				<div class="header-info">
					<div class="header-tag">{t("slider.headerTag")}</div>
					<div class="header-date">{displayDate}</div>
					<div class="header-sub">
						{t("slider.headerSub")}
					</div>
				</div>
				<div class="header-icon">⛽</div>
			</div>
		</div>

		<!-- Progress Bar -->
		<div class="progress-container">
			<div id="progress-bar" class="progress-bar"></div>
		</div>

		<!-- Main Content -->
		<div class="card-body">
			<div class="content-box">
				<!-- Single Item Views -->
				{
					fuelData.map((item, index) => {
						const isDau = item.type === "dau";
						const accentColor = isDau ? "#fbbf24" : "#38bdf8";
						const bgColor = isDau
							? "rgba(251,191,36,0.15)"
							: "rgba(56,189,248,0.15)";
						const diff = (item.v2n - item.v1n).toLocaleString(
							numLocale,
						);

						return (
							<div
								class="slide-item single-item"
								data-slide-index={index}
								data-type={item.type}
								style={`--accent: ${accentColor}; --accent-bg: ${bgColor};`}
							>
								<div class="item-header">
									<div class="type-icon">
										{isDau ? "🛢️" : "⛽"}
									</div>
									<div class="item-title-wrap">
										<div
											class="item-name"
											title={item.shortName}
										>
											{item.shortName}
										</div>
										<div class="item-sub">
											{item.sub
												? item.sub
												: isDau
													? t("slider.subDiesel")
													: t("slider.subGasoline")}
										</div>
									</div>
									<div class="item-badge">
										{String(index + 1).padStart(2, "0")}/
										{String(fuelData.length).padStart(
											2,
											"0",
										)}
									</div>
								</div>

								<div class="prices-grid">
									<div class="price-card">
										<div class="price-label">
											{t("slider.zone1")}
										</div>
										<div
											class="price-value"
											style="color: #ffffff;"
										>
											{item.v1}
										</div>
										<div class="price-unit">
											{t("slider.unit")}
										</div>
									</div>
									<div class="price-card">
										<div class="price-label">
											{t("slider.zone2")}
										</div>
										<div
											class="price-value"
											style={`color: ${accentColor};`}
										>
											{item.v2}
										</div>
										<div class="price-unit">
											{t("slider.unit")}
										</div>
									</div>
								</div>

								<div class="diff-box">
									<div class="diff-label">
										{t("slider.diffLabel")}
									</div>
									<div class="diff-value">
										+{diff} {t("slider.currencySymbol")}
									</div>
									<div class="spacer" />
									<div class="diff-sub">
										{t("slider.diffSub")}
									</div>
								</div>
							</div>
						);
					})
				}

				<!-- Summary Table View (Last Slide) -->
				<div
					class="slide-item summary-table"
					data-slide-index={fuelData.length}
				>
					<div class="table-header-top">
						<div class="table-title">
							{t("slider.summaryTitle")}
						</div>
						<div class="table-count">
							{fuelData.length}
							{t("slider.summaryCount")}
						</div>
					</div>
					<div class="table-columns">
						<div class="col-type">{t("slider.colType")}</div>
						<div class="col-v1">{t("slider.zone1")}</div>
						<div class="col-v2">{t("slider.zone2")}</div>
					</div>
					<div class="table-rows">
						{
							fuelData.map((item) => (
								<div class="table-row">
									<div class="row-type">
										<span
											class="type-dot"
											style={`background: ${item.type === "dau" ? "#fbbf24" : "#38bdf8"};`}
										/>
										<span
											class="type-name"
											title={item.shortName}
										>
											{item.shortName}
										</span>
									</div>
									<div class="row-v1">{item.v1}</div>
									<div
										class="row-v2"
										style={`color: ${item.type === "dau" ? "#fbbf24" : "#38bdf8"};`}
									>
										{item.v2}
									</div>
								</div>
							))
						}
					</div>
				</div>
			</div>

			<!-- Indicators -->
			<div class="indicators">
				{
					Array.from({ length: totalSlides }).map((_, idx) => (
						<button
							class="indicator-dot"
							data-target-index={idx}
							aria-label={`Slide ${idx + 1}`}
						/>
					))
				}
			</div>

			<!-- Footer Info -->
			<div class="footer-note">
				<span id="footer-text" set:html={t("slider.footerNote")} />
			</div>
		</div>

		<!-- Card Footer -->
		<div class="card-footer">
			<div class="footer-source">
				<span class="status-dot"></span>
				<span class="source-text">{t("slider.source")}</span>
			</div>
			<div id="slide-counter" class="slide-counter">01/07</div>
		</div>

		<!-- Background Glow -->
		<div class="glow-effect"></div>
	</div>
</div>
<canvas class="hidden w-[320px] h-142" width="320" height="568" id="canvas"
></canvas>
<div class="flex justify-center py-4">
	<video class="hidden w-[320px] h-142" controls id="video"></video>
</div>
<style>
