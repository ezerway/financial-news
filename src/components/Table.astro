---
interface Props {
	header?: Record<string, any>[];
	items: any[];
	title?: string;
	description?: string;
	note?: string;
	widget?: string;
}

const { items, title, description, note, header, widget } = Astro.props;
const itemKeys = Object.keys(items.at(0) || []).map((h) => ({
	label: h,
	key: h,
}));
const tableHeader = header || itemKeys;

const formatValue = (val: any) => {
	if (typeof val === "number") {
		return val.toLocaleString("vi-VN");
	}
	if (typeof val === "string") {
		const trimmed = val.trim();
		if (/^\d+$/.test(trimmed)) {
			const num = Number(trimmed);
			if (Number.isFinite(num)) {
				return num.toLocaleString("vi-VN");
			}
		}
	}
	return val;
};
---

<div
	class="rounded-2xl border border-gray-200 bg-white p-5 shadow-xs transition hover:shadow-md dark:border-white/10 dark:bg-gray-900/90"
>
	{
		title && (
			<div class="mb-4 flex items-center justify-between border-b border-gray-100 pb-3 dark:border-white/10">
				<div>
					<h2 class="flex items-center gap-2 text-base font-bold text-gray-900 dark:text-white">
						<span class="size-2 rounded-full bg-indigo-600 dark:bg-indigo-400" />
						{widget ? <a href={widget}>{title}</a> : title}
					</h2>
					{description && (
						<p
							class="mt-1 text-xs text-gray-500 dark:text-gray-400"
							set:html={description}
						/>
					)}
				</div>
			</div>
		)
	}
	<div class="flow-root">
		<div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
			<div
				class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8"
			>
				<table
					class="min-w-full divide-y divide-gray-200 dark:divide-white/10"
				>
					<thead>
						<tr class="bg-gray-50/80 dark:bg-white/[0.03]">
							{
								tableHeader.map((h, index) => (
									<th
										scope="col"
										class={
											!index
												? "py-3 pr-3 pl-4 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 sm:pl-3 dark:text-gray-300"
												: "px-3 py-3 text-left text-xs font-semibold uppercase tracking-wider text-gray-600 dark:text-gray-300"
										}
									>
										{h.label}
									</th>
								))
							}
						</tr>
					</thead>
					<tbody class="divide-y divide-gray-100 dark:divide-white/5">
						{
							items.map((item) => (
								<tr class="transition-colors hover:bg-indigo-50/40 dark:hover:bg-white/[0.04]">
									{tableHeader.map((h, index) => (
										<td
											class={
												!index
													? "py-3.5 pr-3 pl-4 text-sm font-medium whitespace-nowrap text-gray-900 sm:pl-3 dark:text-white"
													: "px-3 py-3.5 text-sm whitespace-nowrap text-gray-600 dark:text-gray-300"
											}
										>
											<Fragment
												set:html={formatValue(
													item[h.key],
												)}
											/>
										</td>
									))}
								</tr>
							))
						}
					</tbody>
				</table>
			</div>
		</div>
	</div>

	{
		note && (
			<div class="mt-4 flex items-center justify-between border-t border-gray-100 pt-3 dark:border-white/10">
				<div>
					<p
						class="mt-1 text-xs text-gray-500 dark:text-gray-400"
						set:html={note}
					/>
				</div>
			</div>
		)
	}
</div>
