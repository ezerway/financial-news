---
// GasSlider.astro
import { useTranslations } from "@/i18n/ui";
import { toTableItems, attachComparison } from "@libs/commonTransformer";

export interface GasItem {
	id: string;
	shortName: string;
	sub: string | null;
	type1: string;
	type2: string;
	type1n: number;
	type2n: number;
	type1Diff?: number;
	type2Diff?: number;
}

export interface Props {
	collection: any[];
	date: Date;
}

const { collection, date } = Astro.props;

const currentLocale = (Astro.currentLocale || "vi") as "vi" | "en";
const t = useTranslations(currentLocale);
const numLocale = currentLocale === "en" ? "en-US" : "vi-VN";

const items = attachComparison(toTableItems(collection, "gas"), "title", [
	"type_1_price",
	"type_2_price",
]);
const latestEntry = items.at(-1);

const gasData: GasItem[] = (latestEntry?.data || []).map((item: any) => {
	return {
		id: item.title,
		shortName: item.title,
		sub: item.title,
		type1: item.type_1_price?.toLocaleString(numLocale),
		type2: item.type_2_price?.toLocaleString(numLocale),
		type1n: item.type_1_price,
		type2n: item.type_2_price,
		type1Diff: item.type_1_price_diff,
		type2Diff: item.type_2_price_diff,
	};
});

// Chunk gasData into 6 horizontal items per slide
const itemSlides: GasItem[][] = [];
for (let i = 0; i < gasData.length; i += 6) {
	itemSlides.push(gasData.slice(i, i + 6));
}

// Chunk gasData into summary slides (19 items per slide)
const summaryChunkSize = 19;
const summarySlides: GasItem[][] = [];
for (let i = 0; i < gasData.length; i += summaryChunkSize) {
	summarySlides.push(gasData.slice(i, i + summaryChunkSize));
}

const totalSlides = itemSlides.length + summarySlides.length;

const displayDate = `${date.getDate().toString().padStart(2, "0")}. ${(
	date.getMonth() + 1
)
	.toString()
	.padStart(2, "0")}. ${date.getFullYear()}`;
---

<div class="slider-wrapper">
	<div id="capture-target" class="slider-card">
		<!-- Header -->
		<div class="card-header">
			<div class="header-content">
				<div class="header-info">
					<div class="header-tag">{t("gasSlider.headerTitle")}</div>
					<div class="header-date">{displayDate}</div>
					<div class="header-sub">
						{t("gasSlider.headerSub")}
					</div>
				</div>
				<div class="header-icon">🔥</div>
			</div>
		</div>

		<!-- Progress Bar -->
		<div class="progress-container">
			<div id="progress-bar" class="progress-bar"></div>
		</div>

		<!-- Main Content -->
		<div class="card-body">
			<div class="content-box">
				{/* 6 Horizontal Items Per Slide */}
				{
					itemSlides.map((group, slideIdx) => {
						return (
							<div
								class="slide-item horiz-slide"
								data-slide-index={slideIdx}
							>
								<div class="horiz-container">
									{group.map((item) => (
										<div class="horiz-card-6">
											<div class="horiz-left">
												<span class="horiz-icon">🔥</span>
												<span
													class="horiz-name"
													title={item.shortName}
												>
													{item.shortName}
												</span>
											</div>

											<div class="horiz-right">
												<div class="price-chip">
													<span class="chip-label">12K</span>
													<span class="chip-val">{item.type1}</span>
													{item.type1Diff !== undefined && item.type1Diff !== 0 && (
														<span
															class={`chip-diff ${item.type1Diff > 0 ? "diff-up" : "diff-down"}`}
														>
															{item.type1Diff > 0 ? "▲+" : "▼"}
															{item.type1Diff.toLocaleString(numLocale)}
														</span>
													)}
												</div>

												<div class="price-chip chip-orange">
													<span class="chip-label label-orange">45K</span>
													<span class="chip-val val-orange">{item.type2}</span>
													{item.type2Diff !== undefined && item.type2Diff !== 0 && (
														<span
															class={`chip-diff ${item.type2Diff > 0 ? "diff-up" : "diff-down"}`}
														>
															{item.type2Diff > 0 ? "▲+" : "▼"}
															{item.type2Diff.toLocaleString(numLocale)}
														</span>
													)}
												</div>
											</div>
										</div>
									))}
								</div>
							</div>
						);
					})
				}

				{/* Summary Table Slides */}
				{
					summarySlides.map((summaryChunk, sIdx) => {
						const currentSlideIndex = itemSlides.length + sIdx;
						return (
							<div
								class="slide-item summary-table"
								data-slide-index={currentSlideIndex}
							>
								<div class="table-header-top">
									<div class="table-title">
										{t("gasSlider.summaryTitle")} (
										{sIdx + 1}/{summarySlides.length})
									</div>
									<div class="table-count">
										{summaryChunk.length}{" "}
										{t("slider.summaryCount")}
									</div>
								</div>
								<div class="table-columns">
									<div class="col-type">
										{t("gasSlider.colType")}
									</div>
									<div class="col-v1">12KG</div>
									<div class="col-v2">45KG</div>
								</div>
								<div class="table-rows">
									{summaryChunk.map((item) => (
										<div class="table-row">
											<div class="row-type">
												<span
													class="type-dot"
													style="background: #f97316;"
												/>
												<span
													class="type-name"
													title={item.shortName}
												>
													{item.shortName}
												</span>
											</div>
											<div class="row-v1 flex flex-col items-end leading-none">
												<span>{item.type1}</span>
												{item.type1Diff !== undefined &&
													item.type1Diff !== 0 && (
														<span
															class={`text-[7px] font-bold ${item.type1Diff > 0 ? "text-emerald-400" : "text-rose-400"}`}
														>
															{item.type1Diff > 0
																? "▲+"
																: "▼"}
															{item.type1Diff.toLocaleString(
																numLocale,
															)}
														</span>
													)}
											</div>
											<div class="row-v2 flex flex-col items-end leading-none text-orange">
												<span>{item.type2}</span>
												{item.type2Diff !== undefined &&
													item.type2Diff !== 0 && (
														<span
															class={`text-[7px] font-bold ${item.type2Diff > 0 ? "text-emerald-400" : "text-rose-400"}`}
														>
															{item.type2Diff > 0
																? "▲+"
																: "▼"}
															{item.type2Diff.toLocaleString(
																numLocale,
															)}
														</span>
													)}
											</div>
										</div>
									))}
								</div>
							</div>
						);
					})
				}
			</div>

			<!-- Indicators -->
			<div class="indicators">
				{
					Array.from({ length: totalSlides }).map((_, idx) => (
						<button
							class="indicator-dot"
							data-target-index={idx}
							aria-label={`Slide ${idx + 1}`}
						/>
					))
				}
			</div>

			<!-- Footer Note -->
			<div class="footer-note">
				<span>{t("gasSlider.footerTitle")}</span>
			</div>
		</div>

		<!-- Card Footer -->
		<div class="card-footer">
			<div class="footer-source">
				<span class="status-dot"></span>
				<span class="source-text">{t("slider.source")}</span>
			</div>
			<div id="slide-counter" class="slide-counter">
				01/{String(totalSlides).padStart(2, "0")}
			</div>
		</div>

		<!-- Background Glow -->
		<div class="glow-effect"></div>
	</div>
</div>

<style>
	* {
		box-sizing: border-box;
	}

	.slider-wrapper {
		min-height: 100vh;
		background: #050a14;
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 16px;
		font-family:
			-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
	}

	.slider-card {
		width: 320px;
		height: 568px;
		background: #0b1220;
		border-radius: 24px;
		overflow: hidden;
		position: relative;
		display: flex;
		flex-direction: column;
		border: 1px solid #1a2744;
		box-shadow:
			0 20px 60px rgba(0, 0, 0, 0.6),
			0 0 0 1px rgba(255, 255, 255, 0.04) inset;
		flex-shrink: 0;
	}

	.card-header {
		padding: 16px 16px 10px 16px;
		width: 320px;
		max-width: 320px;
		overflow: hidden;
	}

	.header-content {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 8px;
		width: 100%;
		max-width: 288px;
	}

	.header-info {
		min-width: 0;
		flex: 1;
	}

	.header-tag {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 1.6px;
		color: #f97316;
		line-height: 14px;
		text-transform: uppercase;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.header-date {
		font-size: 18px;
		font-weight: 800;
		color: #ffffff;
		line-height: 22px;
		margin-top: 2px;
		letter-spacing: -0.3px;
		font-variant-numeric: tabular-nums;
	}

	.header-sub {
		font-size: 10px;
		font-weight: 500;
		color: #6b7a94;
		margin-top: 2px;
		line-height: 12px;
	}

	.header-icon {
		width: 32px;
		height: 32px;
		border-radius: 10px;
		background: #162032;
		border: 1px solid #1f2e4a;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
		font-size: 15px;
	}

	.progress-container {
		width: 320px;
		height: 2px;
		background: #162032;
		position: relative;
		overflow: hidden;
		flex-shrink: 0;
	}

	.progress-bar {
		height: 100%;
		width: 0%;
		background: #f97316;
	}

	.progress-bar.animate {
		animation: prog 3s linear forwards;
	}

	@keyframes prog {
		from {
			width: 0%;
		}
		to {
			width: 100%;
		}
	}

	@keyframes fadeUp {
		from {
			opacity: 0;
			transform: translateY(6px);
		}
		to {
			opacity: 1;
			transform: translateY(0);
		}
	}

	.card-body {
		flex: 1;
		width: 320px;
		padding: 8px 10px 6px 10px;
		display: flex;
		flex-direction: column;
		align-items: center;
		overflow: hidden;
		min-height: 0;
	}

	.content-box {
		width: 300px;
		max-width: 300px;
		background: #162032;
		border: 1px solid #1f2e4a;
		border-radius: 16px;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		min-height: 0;
		position: relative;
		padding-top: 4px;
		padding-bottom: 4px;
		flex: 1;
	}

	.slide-item {
		display: none;
		width: 100%;
		max-width: 300px;
		padding: 6px;
		overflow: hidden;
		height: 100%;
	}

	.slide-item.active {
		display: flex;
		flex-direction: column;
		animation: fadeUp 0.35s ease;
	}

	/* 6 Horizontal Items Stacked Layout */
	.horiz-container {
		display: flex;
		flex-direction: column;
		gap: 5px;
		width: 100%;
		height: 100%;
		justify-content: space-between;
	}

	.horiz-card-6 {
		flex: 1;
		min-height: 0;
		background: #0f1a2e;
		border: 1px solid #1a2942;
		border-radius: 10px;
		padding: 5px 8px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 6px;
		overflow: hidden;
	}

	.horiz-left {
		display: flex;
		align-items: center;
		gap: 5px;
		min-width: 0;
		flex: 1;
	}

	.horiz-icon {
		font-size: 11px;
		flex-shrink: 0;
	}

	.horiz-name {
		font-size: 11px;
		font-weight: 700;
		color: #ffffff;
		line-height: 13px;
		white-space: normal;
		word-break: break-word;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
		flex: 1;
		min-width: 0;
	}

	.horiz-right {
		display: flex;
		align-items: center;
		gap: 4px;
		flex-shrink: 0;
	}

	.price-chip {
		background: #080f1d;
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 5px;
		padding: 2px 5px;
		display: flex;
		align-items: center;
		gap: 3px;
		line-height: 11px;
	}

	.price-chip.chip-orange {
		border-color: rgba(249, 115, 22, 0.25);
		background: rgba(249, 115, 22, 0.06);
	}

	.chip-label {
		font-size: 8px;
		font-weight: 700;
		color: #6b7a94;
		letter-spacing: 0.3px;
		text-transform: uppercase;
	}

	.chip-label.label-orange {
		color: #f97316;
	}

	.chip-val {
		font-size: 11px;
		font-weight: 800;
		color: #ffffff;
		font-variant-numeric: tabular-nums;
		letter-spacing: -0.2px;
	}

	.chip-val.val-orange {
		color: #f97316;
	}

	.chip-diff {
		font-size: 8px;
		font-weight: 700;
		padding: 0.5px 3px;
		border-radius: 3px;
		line-height: 10px;
	}

	.diff-up {
		color: #34d399;
		background: rgba(52, 211, 153, 0.15);
	}

	.diff-down {
		color: #fb7185;
		background: rgba(251, 113, 133, 0.15);
	}

	/* Summary Table Styles */
	.slide-item.summary-table {
		padding: 0;
	}

	.table-header-top {
		padding: 6px 8px 4px 8px;
		display: flex;
		justify-content: space-between;
		align-items: center;
		border-bottom: 1px solid #1f2e4a;
		width: 100%;
	}

	.table-title {
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.5px;
		color: #f97316;
		text-transform: uppercase;
	}

	.table-count {
		font-size: 8px;
		font-weight: 600;
		color: #6b7a94;
		background: #0f1a2e;
		border-radius: 3px;
		padding: 1px 4px;
	}

	.table-columns {
		display: flex;
		width: 100%;
		padding: 3px 8px;
		gap: 4px;
		background: #0f1a2e;
		border-bottom: 1px solid #1f2e4a;
		font-size: 8px;
		font-weight: 700;
		color: #5a6b8a;
		letter-spacing: 0.3px;
		text-transform: uppercase;
	}

	.col-type {
		width: 40%;
	}
	.col-v1 {
		width: 30%;
		text-align: right;
	}
	.col-v2 {
		width: 30%;
		text-align: right;
	}

	.table-rows {
		width: 100%;
		display: flex;
		flex-direction: column;
	}

	.table-row {
		display: flex;
		align-items: center;
		width: 100%;
		height: 19px;
		padding: 0 8px;
		gap: 3px;
		border-bottom: 1px solid rgba(31, 46, 74, 0.4);
		overflow: hidden;
	}

	.row-type {
		width: 40%;
		min-width: 0;
		overflow: hidden;
		display: flex;
		align-items: center;
		gap: 3px;
	}

	.type-dot {
		width: 4px;
		height: 4px;
		border-radius: 2px;
		flex-shrink: 0;
	}

	.type-name {
		font-size: 9px;
		font-weight: 600;
		color: #e2e8f0;
		line-height: 10px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.row-v1 {
		width: 30%;
		font-size: 9px;
		font-weight: 700;
		color: #ffffff;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.row-v2 {
		width: 30%;
		font-size: 9px;
		font-weight: 800;
		text-align: right;
		font-variant-numeric: tabular-nums;
	}

	.indicators {
		display: flex;
		gap: 4px;
		margin-top: 6px;
		align-items: center;
		justify-content: center;
		width: 300px;
		max-width: 300px;
		flex-wrap: wrap;
	}

	.indicator-dot {
		width: 5px;
		height: 5px;
		border-radius: 999px;
		border: none;
		background: #2a3a5a;
		cursor: pointer;
		padding: 0;
		transition: all 0.25s ease;
		flex-shrink: 0;
	}

	.indicator-dot.active {
		width: 14px;
		background: #f97316;
	}

	.footer-note {
		margin-top: 4px;
		width: 300px;
		max-width: 300px;
		display: flex;
		justify-content: center;
		overflow: hidden;
	}

	.footer-note span {
		font-size: 8px;
		font-weight: 500;
		color: #3d4f6b;
	}

	.card-footer {
		width: 320px;
		max-width: 320px;
		height: 30px;
		border-top: 1px solid #162032;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0 16px;
		overflow: hidden;
		flex-shrink: 0;
	}

	.footer-source {
		display: flex;
		align-items: center;
		gap: 6px;
		min-width: 0;
		overflow: hidden;
	}

	.status-dot {
		width: 4px;
		height: 4px;
		border-radius: 2px;
		background: #22c55e;
		flex-shrink: 0;
	}

	.source-text {
		font-size: 9px;
		font-weight: 600;
		color: #5a6b8a;
		letter-spacing: 0.3px;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	.slide-counter {
		font-size: 9px;
		font-weight: 700;
		color: #3d4f6b;
		font-variant-numeric: tabular-nums;
		white-space: nowrap;
		flex-shrink: 0;
	}

	.glow-effect {
		position: absolute;
		top: -40px;
		left: 50%;
		transform: translateX(-50%);
		width: 200px;
		height: 200px;
		background: radial-gradient(
			circle,
			rgba(249, 115, 22, 0.12) 0%,
			transparent 70%
		);
		pointer-events: none;
	}
</style>

<script>
	let currentIndex = 0;
	let timer: number | null = null;
	const slides = document.querySelectorAll(".slide-item");
	const dots = document.querySelectorAll(".indicator-dot");
	const progressBar = document.getElementById("progress-bar");
	const slideCounter = document.getElementById("slide-counter");
	const totalSlides = slides.length;

	function showSlide(index: number) {
		slides.forEach((s) => s.classList.remove("active"));
		dots.forEach((d) => d.classList.remove("active"));

		if (slides[index]) slides[index].classList.add("active");
		if (dots[index]) dots[index].classList.add("active");

		if (slideCounter) {
			const currentStr = String(index + 1).padStart(2, "0");
			const totalStr = String(totalSlides).padStart(2, "0");
			slideCounter.textContent = `${currentStr}/${totalStr}`;
		}

		if (progressBar) {
			progressBar.classList.remove("animate");
			void progressBar.offsetWidth;
			progressBar.classList.add("animate");
		}
	}

	function nextSlide() {
		currentIndex = (currentIndex + 1) % totalSlides;
		showSlide(currentIndex);
	}

	function startTimer() {
		if (timer) clearInterval(timer);
		timer = window.setInterval(nextSlide, 3000);
	}

	dots.forEach((dot) => {
		dot.addEventListener("click", (e) => {
			const target = e.currentTarget as HTMLElement;
			const idx = target.dataset.targetIndex;
			if (idx !== undefined) {
				currentIndex = parseInt(idx, 10);
				showSlide(currentIndex);
				startTimer();
			}
		});
	});

	if (totalSlides > 0) {
		showSlide(0);
		startTimer();
	}
</script>
