<script>
	let currentIndex = 0;
	let timer: number | null = null;
	const totalSlides = document.querySelectorAll(".slide-card").length;

	const slides = document.querySelectorAll(".slide-card");
	const dots = document.querySelectorAll(".dot-btn");
	const slideCounter = document.getElementById("slide-counter");

	function getSlideInterval(index: number): number {
		// Thời gian chờ ở trang tổng hợp dài hơn (3.8s), các trang chi tiết (2.6s)
		// return index === totalSlides - 1 ? 3800 : 2600;
		return 3000;
	}

	function updateSlider(index: number) {
		currentIndex = index;

		// Cập nhật hiển thị thẻ active
		slides.forEach((slide, idx) => {
			if (idx === currentIndex) {
				slide.classList.add("active");
			} else {
				slide.classList.remove("active");
			}
		});

		// Cập nhật trạng thái các chấm chuyển slide
		dots.forEach((dot, idx) => {
			if (idx === currentIndex) {
				dot.classList.add("active");
			} else {
				dot.classList.remove("active");
			}
		});

		// Cập nhật số đếm slide (ví dụ: 1/7)
		if (slideCounter) {
			slideCounter.textContent = `${currentIndex + 1}/${totalSlides}`;
		}
	}

	function startNextTimeout() {
		stopTimeout();
		const interval = getSlideInterval(currentIndex);
		timer = window.setTimeout(() => {
			const nextIndex = (currentIndex + 1) % totalSlides;
			updateSlider(nextIndex);
			startNextTimeout();
		}, interval);
	}

	function stopTimeout() {
		if (timer !== null) {
			clearTimeout(timer);
			timer = null;
		}
	}

	// Lắng nghe sự kiện click trực tiếp vào chấm chọn trang
	dots.forEach((dot) => {
		dot.addEventListener("click", (e) => {
			const target = e.currentTarget as HTMLElement;
			const index = parseInt(
				target.getAttribute("data-target-index") || "0",
				10,
			);
			updateSlider(index);
			startNextTimeout(); // Reset lại thời gian chờ tự động chuyển
		});
	});

	// Khởi chạy slider khi tải trang
	updateSlider(0);
	startNextTimeout();
</script>

<script type="module">
	import domtoimage from "https://cdn.jsdelivr.net/npm/dom-to-image-more@3.10.2/+esm";

	const target = document.getElementById("capture-target");
	let canvas = document.querySelector("canvas");
	let ctx = canvas.getContext("2d");
	var video = document.querySelector("video");

	let images = [];
	let chunks = [];
	let mediaRecorder;
	let interval;

	const start = async () => {
		mediaRecorder = null;
		let videoStream = canvas.captureStream(30);
		mediaRecorder = new MediaRecorder(videoStream);
		interval = setInterval(() => {
			domtoimage
				.toPng(target)
				.then((dataUrl) => {
					var base_img = new Image();
					base_img.src = dataUrl;
					base_img.onload = () => {
						ctx.drawImage(base_img, 0, 0);
						images.push(base_img);
					};
				})
				.catch((error) => {
					console.error("oops, something went wrong!", error);
				});
		}, 100);

		chunks = [];
		mediaRecorder.ondataavailable = (e) => {
			chunks.push(e.data);
		};
		mediaRecorder.onstop = (e) => {
			// mp4 or webm
			let type = "video/mp4";
			if (MediaRecorder.isTypeSupported("video/mp4;codecs=avc1")) {
				type = "video/mp4;codecs=avc1";
			} else if (MediaRecorder.isTypeSupported("video/mp4")) {
				type = "video/mp4";
			} else if (MediaRecorder.isTypeSupported("video/webm")) {
				type = "video/webm";
			}
			var blob = new Blob(chunks, { type: type });
			chunks = [];
			var videoURL = URL.createObjectURL(blob);
			video.src = videoURL;
			video.classList.remove("hidden");
			// download video
			// const downloadLink = document.createElement("a");
			// downloadLink.href = videoURL;
			// downloadLink.download = `gold-${new Date().toLocaleDateString()}.mp4`;
			// downloadLink.click();
		};
		mediaRecorder.start();
	};

	const stop = async () => {
		clearInterval(interval);
		mediaRecorder.stop();
	};

	const totalSlides = document.querySelectorAll(".slide-card").length;
	const slideInterval = 3000;
	const footerText = document.querySelector(".au-badge");

	footerText.addEventListener("click", () => {
		start();
		setTimeout(
			() => {
				stop();
			},
			5000 + slideInterval * totalSlides,
		);
	});
</script>
