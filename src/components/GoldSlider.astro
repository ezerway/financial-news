---
// GoldSlider.astro
import { useTranslations } from "@/i18n/ui";
import { toTableItems, attachComparison } from "@libs/commonTransformer";

export interface GoldItem {
	id: string;
	short: string;
	sub: string;
	buy: string;
	sell: string;
	buyDiff?: number;
	sellDiff?: number;
}

export interface Props {
	collection: any[];
	date: Date;
}

const { collection, date } = Astro.props;

const currentLocale = (Astro.currentLocale || "vi") as "vi" | "en";
const t = useTranslations(currentLocale);
const numLocale = currentLocale === "en" ? "en-US" : "vi-VN";

const items = attachComparison(toTableItems(collection, "gold"), "masp", [
	"giamua",
	"giaban",
]);
const latestEntry = items.at(-1);

const goldData: GoldItem[] = (latestEntry?.data || [])
	.slice(0, 7)
	.map((item: any) => {
		return {
			id: item.masp,
			short: item.tensp,
			sub: item.masp,
			buy: item.giaban?.toLocaleString(numLocale),
			sell: item.giamua?.toLocaleString(numLocale),
			buyDiff: item.giaban_diff,
			sellDiff: item.giamua_diff,
		};
	});

const totalSlides = goldData.length + 1;

const displayDate = `${date.getDate().toString().padStart(2, "0")}. ${(
	date.getMonth() + 1
)
	.toString()
	.padStart(2, "0")}. ${date.getFullYear()}`;
---

<div class="gold-slider-container">
	<div id="capture-target" class="video-root">
		<!-- Glow Effect Header -->
		<div class="glow-bg"></div>

		<!-- Header Section -->
		<div class="header-section">
			<div class="header-top">
				<span class="header-title">{t("goldSlider.headerTitle")}</span>
				<span class="live-badge">LIVE</span>
			</div>
			<div class="header-date">{displayDate}</div>
			<div class="header-sub">
				{t("goldSlider.headerSub")}
			</div>

			<!-- Indicators -->
			<div class="indicators-wrap">
				{
					Array.from({ length: totalSlides }).map((_, idx) => (
						<button
							class="dot-btn"
							data-target-index={idx}
							aria-label={`Slide ${idx + 1}`}
						/>
					))
				}
				<div class="spacer"></div>
				<div id="slide-counter" class="slide-counter">
					1/{totalSlides}
				</div>
			</div>
		</div>

		<!-- Main Content Slide Area -->
		<div class="content-area">
			<!-- Summary Table (First Slide) -->
			<div
				class="slide-card table-summary"
				data-slide-index={0}
			>
				<div class="table-top">
					<div class="table-title">
						{t("goldSlider.summaryTitle")}
					</div>
					<div class="table-date">{displayDate}</div>
				</div>

				<div class="table-cols">
					<div class="col-type">{t("goldSlider.colType")}</div>
					<div class="col-price col-buy">{t("goldSlider.buy")}</div>
					<div class="col-price col-sell">{t("goldSlider.sell")}</div>
				</div>

				<div class="table-rows">
					{
						goldData.map((item) => (
							<div class="table-row">
								<div class="row-type">
									<div class="row-short">{item.short}</div>
									<div class="row-sub">{item.id}</div>
								</div>
								<div class="row-price buy-text flex-col items-end leading-tight">
									<span>{item.buy}</span>
									{item.buyDiff !== undefined &&
										item.buyDiff !== 0 && (
											<span
												class={`text-[16px] font-bold ${item.buyDiff > 0 ? "text-emerald-400" : "text-rose-400"}`}
											>
												{item.buyDiff > 0 ? "▲+" : "▼"}
												{item.buyDiff.toLocaleString(
													numLocale,
												)}
											</span>
										)}
								</div>
								<div class="row-price sell-text flex-col items-end leading-tight">
									<span>{item.sell}</span>
									{item.sellDiff !== undefined &&
										item.sellDiff !== 0 && (
											<span
												class={`text-[16px] font-bold ${item.sellDiff > 0 ? "text-emerald-400" : "text-rose-400"}`}
											>
												{item.sellDiff > 0 ? "▲+" : "▼"}
												{item.sellDiff.toLocaleString(
													numLocale,
												)}
											</span>
										)}
								</div>
							</div>
						))
					}
				</div>
			</div>

			<!-- Single Gold Cards -->
			{
				goldData.map((item, index) => {
					const diff = (parseFloat(item.sell) - parseFloat(item.buy))
						.toFixed(3)
						.slice(0, 5);
					return (
						<div
							class="slide-card card-item"
							data-slide-index={index + 1}
						>
							<div class="card-header">
								<div class="badge-icon">
									{item.id.slice(0, 4)}
								</div>
								<div class="info-wrap">
									<div class="item-short" title={item.short}>
										{item.short}
									</div>
									<div class="item-sub">{item.sub}</div>
								</div>
							</div>

							<div class="divider" />

							<div class="price-grid">
								<div class="price-box buy-box">
									<div class="price-label buy-label">
										{t("goldSlider.buy")}
									</div>
									<div class="price-value buy-value">
										{item.buy}
									</div>
									{item.buyDiff !== undefined &&
										item.buyDiff !== 0 && (
											<div
												class={`text-[18px] font-bold px-3 py-1 rounded-full ${item.buyDiff > 0 ? "text-emerald-400 bg-emerald-500/10" : "text-rose-400 bg-rose-500/10"}`}
											>
												{item.buyDiff > 0
													? "▲ +"
													: "▼ "}
												{item.buyDiff.toLocaleString(
													numLocale,
												)}
											</div>
										)}
									<div class="price-unit buy-unit">
										{t("goldSlider.unit")}
									</div>
								</div>

								<div class="price-box sell-box">
									<div class="price-label sell-label">
										{t("goldSlider.sell")}
									</div>
									<div class="price-value sell-value">
										{item.sell}
									</div>
									{item.sellDiff !== undefined &&
										item.sellDiff !== 0 && (
											<div
												class={`text-[18px] font-bold px-3 py-1 rounded-full ${item.sellDiff > 0 ? "text-emerald-400 bg-emerald-500/10" : "text-rose-400 bg-rose-500/10"}`}
											>
												{item.sellDiff > 0
													? "▲ +"
													: "▼ "}
												{item.sellDiff.toLocaleString(
													numLocale,
												)}
											</div>
										)}
									<div class="price-unit sell-unit">
										{t("goldSlider.unit")}
									</div>
								</div>
							</div>

							<div class="card-footer-info">
								<div class="diff-text">
									{t("goldSlider.diffLabel")}{" "}
									<span class="diff-num">
										{diff} {t("goldSlider.unit")}
									</span>
								</div>
								<div class="icon-arrow">↗</div>
							</div>
						</div>
					);
				})
			}
		</div>

		<!-- Footer Section -->
		<div class="footer-section">
			<div class="footer-left">
				<div class="au-badge">Au</div>
				<div class="footer-info">
					<div class="footer-title">
						{t("goldSlider.footerTitle")}
					</div>
					<div class="footer-sub">financial-news.ezerway.com</div>
				</div>
			</div>
			<div class="footer-ratio">{t("slider.source")}</div>
		</div>
	</div>
</div>

<canvas
	class="hidden w-[640px] h-[1136px]"
	width="640"
	height="1136"
	id="canvas"></canvas>
<div class="flex justify-center py-4">
	<video class="hidden w-[640px] h-[1136px]" controls id="video"></video>
