---
import { getCollection } from "astro:content";
import { toTableItems, attachComparison } from "@libs/commonTransformer";
import { useTranslations, getLocalizedPath } from "@/i18n/ui";

interface Props {
	locale?: "vi" | "en";
}

const { locale = "vi" } = Astro.props;
const t = useTranslations(locale);

// Fetch latest market snapshots for retention
let sjcItem: any = null;
let ron95Item: any = null;
let e5Item: any = null;

try {
	const rawGold = await getCollection("gold");
	const goldItems = attachComparison(toTableItems(rawGold, "gold"), "masp", ["giamua", "giaban"]);
	const latestGold = goldItems.at(-1)?.data || [];
	sjcItem = latestGold.find((i: any) => 
		(i.masp && String(i.masp).toUpperCase().includes("SJC")) || 
		(i.tensp && String(i.tensp).toUpperCase().includes("SJC"))
	) || latestGold[0];

	const rawOil = await getCollection("oil");
	const oilItems = attachComparison(toTableItems(rawOil, "oil"), "title", ["zone1_price", "zone2_price"]);
	const latestOil = oilItems.at(-1)?.data || [];
	ron95Item = latestOil.find((i: any) => 
		i.title && (String(i.title).includes("95-V") || String(i.title).includes("95-III") || String(i.title).includes("95"))
	) || latestOil[0];
	e5Item = latestOil.find((i: any) => 
		i.title && String(i.title).includes("92")
	) || latestOil[1];
} catch (err) {
	console.error("Failed to load snapshot data for redirect page:", err);
}

const numLocale = locale === "en" ? "en-US" : "vi-VN";
const formatVal = (val: any) => {
	if (typeof val === "number") return val.toLocaleString(numLocale);
	if (typeof val === "string") {
		const trimmed = val.trim();
		if (/^\d+$/.test(trimmed)) {
			const n = Number(trimmed);
			if (Number.isFinite(n)) return n.toLocaleString(numLocale);
		}
	}
	return val || "-";
};

const homeUrl = getLocalizedPath("/", locale);
const goldUrl = getLocalizedPath("/gold/", locale);
const oilUrl = getLocalizedPath("/oil/", locale);
---

<div class="mx-auto w-full max-w-2xl px-4 py-4 sm:px-6 sm:py-8 flex flex-col justify-center my-auto pb-16 sm:pb-24">
	<!-- Main Redirect Card -->
	<div class="overflow-hidden rounded-3xl border border-gray-200 bg-white p-6 shadow-xl dark:border-white/10 dark:bg-gray-900 sm:p-10">
		<!-- Active Redirect State -->
		<div id="redirect-active-state" class="flex flex-col items-center text-center">
			<!-- Animated Icon / Ping Indicator -->
			<div class="relative mb-6 flex items-center justify-center">
				<span class="absolute inline-flex h-20 w-20 animate-ping rounded-full bg-indigo-400 opacity-25 dark:bg-indigo-600"></span>
				<div class="relative flex h-16 w-16 items-center justify-center rounded-2xl bg-indigo-50 text-indigo-600 shadow-inner dark:bg-indigo-950/60 dark:text-indigo-400">
					<svg class="h-8 w-8 animate-spin" fill="none" viewBox="0 0 24 24">
						<circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
						<path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"></path>
					</svg>
				</div>
			</div>

			<h1 class="text-2xl font-black tracking-tight text-gray-900 dark:text-white sm:text-3xl">
				{t("redirect.heading")}
			</h1>
			
			<p class="mt-2 text-sm text-gray-500 dark:text-gray-400">
				{t("redirect.notice")}
			</p>

			<!-- Destination URL Preview Pill -->
			<div class="mt-4 flex max-w-full items-center gap-2 rounded-xl bg-gray-50 px-4 py-2.5 border border-gray-200/80 text-left dark:bg-gray-800/80 dark:border-white/10">
				<svg class="h-4 w-4 shrink-0 text-indigo-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
				</svg>
				<span id="target-domain" class="font-semibold text-gray-900 dark:text-white truncate text-sm">--</span>
				<span class="rounded bg-indigo-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-indigo-700 dark:bg-indigo-900/60 dark:text-indigo-300">
					Link Out
				</span>
			</div>

			<!-- Countdown Display -->
			<div class="mt-6 flex flex-col items-center">
				<div class="flex items-baseline gap-1.5 text-4xl font-extrabold text-indigo-600 dark:text-indigo-400">
					<span id="countdown-num">5</span>
					<span class="text-base font-medium text-gray-500 dark:text-gray-400">s</span>
				</div>
				<p class="mt-1 text-xs text-gray-500 dark:text-gray-400">
					{locale === "en" ? "Redirecting automatically..." : "Đang chuẩn bị chuyển tiếp tự động..."}
				</p>
			</div>

			<!-- Progress Bar -->
			<div class="mt-4 h-2 w-full max-w-xs overflow-hidden rounded-full bg-gray-100 dark:bg-gray-800">
				<div id="countdown-progress" class="h-full rounded-full bg-indigo-600 transition-all duration-75 dark:bg-indigo-500" style="width: 0%;"></div>
			</div>

			<!-- Action Buttons -->
			<div class="mt-8 mb-2 flex w-full flex-col gap-3 sm:flex-row sm:justify-center">
				<a
					id="btn-proceed"
					href="#"
					rel="nofollow noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2 dark:focus:ring-offset-gray-900"
				>
					<span>{t("redirect.proceed")}</span>
					<svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
						<path stroke-linecap="round" stroke-linejoin="round" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
					</svg>
				</a>
				<a
					href={homeUrl}
					class="inline-flex items-center justify-center rounded-xl border border-gray-200 bg-white px-6 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-50 dark:border-white/10 dark:bg-gray-800 dark:text-gray-200 dark:hover:bg-gray-700/60"
				>
					{t("redirect.cancel")}
				</a>
			</div>
		</div>

		<!-- Error / Missing Target State (Hidden by default) -->
		<div id="redirect-error-state" class="hidden flex-col items-center text-center">
			<div class="mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-50 text-amber-600 shadow-inner dark:bg-amber-950/60 dark:text-amber-400">
				<svg class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
					<path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
				</svg>
			</div>

			<h2 class="text-2xl font-black tracking-tight text-gray-900 dark:text-white sm:text-3xl">
				{t("redirect.invalidTitle")}
			</h2>

			<p class="mt-3 max-w-md text-sm text-gray-500 dark:text-gray-400">
				{t("redirect.invalidDesc")}
			</p>

			<div class="mt-6 rounded-xl bg-gray-50 p-4 font-mono text-xs text-gray-600 border border-gray-200 dark:bg-gray-800 dark:text-gray-300 dark:border-white/10">
				<code>?to=https://example.com</code>
			</div>

			<div class="mt-8">
				<a
					href={homeUrl}
					class="inline-flex items-center justify-center rounded-xl bg-indigo-600 px-6 py-3 text-sm font-semibold text-white shadow-md transition hover:bg-indigo-500"
				>
					{t("redirect.backHome")}
				</a>
			</div>
		</div>
	</div>

	<!-- Traffic Retention: Today's Market Highlights -->
	<div class="mt-12 sm:mt-14 pt-8 border-t border-gray-100 dark:border-white/10">
		<div class="mb-4 flex items-center justify-between">
			<h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400">
				{t("redirect.marketSnap")}
			</h3>
			<a href={homeUrl} class="text-xs font-semibold text-indigo-600 hover:text-indigo-500 dark:text-indigo-400">
				{locale === "en" ? "View all prices →" : "Xem tất cả bảng giá →"}
			</a>
		</div>

		<div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
			<!-- Gold Highlight -->
			{sjcItem && (
				<a
					href={goldUrl}
					class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-md dark:border-white/10 dark:bg-gray-900/90 dark:hover:border-indigo-500/40"
				>
					<div class="flex items-center justify-between">
						<span class="text-xs font-bold uppercase tracking-wider text-amber-600 dark:text-amber-400">
							{locale === "en" ? "Gold SJC" : "Vàng SJC"}
						</span>
						<span class="rounded bg-amber-50 px-1.5 py-0.5 text-[10px] font-semibold text-amber-700 dark:bg-amber-950/60 dark:text-amber-300">
							{sjcItem.masp || "SJC"}
						</span>
					</div>
					<div class="mt-3">
						<div class="flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span>{locale === "en" ? "Sell:" : "Bán ra:"}</span>
							<span class="font-extrabold text-sm text-gray-900 dark:text-white">
								{formatVal(sjcItem.giaban)}
							</span>
						</div>
						<div class="mt-1 flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span>{locale === "en" ? "Buy:" : "Mua vào:"}</span>
							<span class="font-medium text-gray-700 dark:text-gray-300">
								{formatVal(sjcItem.giamua)}
							</span>
						</div>
					</div>
				</a>
			)}

			<!-- Oil RON 95 Highlight -->
			{ron95Item && (
				<a
					href={oilUrl}
					class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-md dark:border-white/10 dark:bg-gray-900/90 dark:hover:border-indigo-500/40"
				>
					<div class="flex items-center justify-between gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-blue-600 dark:text-blue-400 truncate">
							{ron95Item.title || "Xăng RON 95"}
						</span>
						<span class="rounded bg-blue-50 px-1.5 py-0.5 text-[10px] font-semibold text-blue-700 whitespace-nowrap shrink-0 dark:bg-blue-950/60 dark:text-blue-300">
							RON 95
						</span>
					</div>
					<div class="mt-3">
						<div class="flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span class="whitespace-nowrap">{locale === "en" ? "Zone 1:" : "Vùng 1:"}</span>
							<span class="font-extrabold text-sm text-gray-900 dark:text-white whitespace-nowrap">
								{formatVal(ron95Item.zone1_price)} đ
							</span>
						</div>
						<div class="mt-1 flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span class="whitespace-nowrap">{locale === "en" ? "Zone 2:" : "Vùng 2:"}</span>
							<span class="font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap">
								{formatVal(ron95Item.zone2_price)} đ
							</span>
						</div>
					</div>
				</a>
			)}

			<!-- Oil E5 Highlight -->
			{e5Item && (
				<a
					href={oilUrl}
					class="group flex flex-col justify-between rounded-2xl border border-gray-200 bg-white p-4 transition hover:border-indigo-300 hover:shadow-md dark:border-white/10 dark:bg-gray-900/90 dark:hover:border-indigo-500/40"
				>
					<div class="flex items-center justify-between gap-2">
						<span class="text-xs font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 truncate">
							{e5Item.title || "Xăng E5 RON 92"}
						</span>
						<span class="rounded bg-emerald-50 px-1.5 py-0.5 text-[10px] font-semibold text-emerald-700 whitespace-nowrap shrink-0 dark:bg-emerald-950/60 dark:text-emerald-300">
							E5 RON 92
						</span>
					</div>
					<div class="mt-3">
						<div class="flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span class="whitespace-nowrap">{locale === "en" ? "Zone 1:" : "Vùng 1:"}</span>
							<span class="font-extrabold text-sm text-gray-900 dark:text-white whitespace-nowrap">
								{formatVal(e5Item.zone1_price)} đ
							</span>
						</div>
						<div class="mt-1 flex items-baseline justify-between text-xs text-gray-500 dark:text-gray-400">
							<span class="whitespace-nowrap">{locale === "en" ? "Zone 2:" : "Vùng 2:"}</span>
							<span class="font-medium text-gray-700 dark:text-gray-300 whitespace-nowrap">
								{formatVal(e5Item.zone2_price)} đ
							</span>
						</div>
					</div>
				</a>
			)}
		</div>
	</div>
</div>

<script is:inline>
(function() {
	const params = new URLSearchParams(window.location.search);
	const rawTarget = params.get("to") || params.get("url") || params.get("target") || "";

	const activeStateEl = document.getElementById("redirect-active-state");
	const errorStateEl = document.getElementById("redirect-error-state");
	const targetDomainEl = document.getElementById("target-domain");
	const countdownNumEl = document.getElementById("countdown-num");
	const countdownProgressEl = document.getElementById("countdown-progress");
	const btnProceedEl = document.getElementById("btn-proceed");

	function validateUrl(input) {
		if (!input) return null;
		try {
			// Handle protocol-relative or decoded forms
			const decoded = decodeURIComponent(input.trim());
			const parsed = new URL(decoded);
			if (parsed.protocol === "http:" || parsed.protocol === "https:") {
				return parsed;
			}
			return null;
		} catch (e) {
			return null;
		}
	}

	const targetUrl = validateUrl(rawTarget);

	if (!targetUrl) {
		if (activeStateEl) activeStateEl.classList.add("hidden");
		if (errorStateEl) errorStateEl.classList.remove("hidden");
		return;
	}

	// Valid Target Setup
	if (targetDomainEl) {
		targetDomainEl.textContent = targetUrl.hostname;
	}

	if (btnProceedEl) {
		btnProceedEl.setAttribute("href", targetUrl.href);
		btnProceedEl.addEventListener("click", function(e) {
			e.preventDefault();
			window.location.replace(targetUrl.href);
		});
	}

	// Countdown logic: 5.0 seconds total
	const totalDuration = 5000;
	const intervalStep = 50;
	let elapsed = 0;

	const timer = setInterval(function() {
		elapsed += intervalStep;
		const progress = Math.min((elapsed / totalDuration) * 100, 100);
		if (countdownProgressEl) {
			countdownProgressEl.style.width = progress + "%";
		}

		const remainingSeconds = Math.max(1, Math.ceil((totalDuration - elapsed) / 1000));
		if (countdownNumEl) {
			countdownNumEl.textContent = String(remainingSeconds);
		}

		if (elapsed >= totalDuration) {
			clearInterval(timer);
			window.location.replace(targetUrl.href);
		}
	}, intervalStep);
})();
</script>
